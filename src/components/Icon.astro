---
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: cls = 'size-5', label } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d={ICONS[name]} />
</svg>
