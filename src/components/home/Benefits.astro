---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import model from '../../data/model.json';
import { yuan } from '../../lib/format';
import type { IconName } from '../../lib/icons';

const wan = Math.round(model.typical.monthlySalesYuan / 10000);
const items: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'shield-check',
    title: '放心承诺退换货',
    body: '退回商品折价处理的损失由保险分担。您可以更从容地向顾客承诺退换货，顾客也更愿意试穿和购买。',
  },
  {
    icon: 'calendar',
    title: '退货集中的月份有保障',
    body: '换季、节假日退货扎堆时，超出每月免赔额的部分按笔赔付，单月赔付不封顶。',
  },
  {
    icon: 'wallet',
    title: '保费随销售额浮动',
    body: `保费按当月销售额计算，淡季交得少。以月销售额 ${wan} 万元的女装店为例，常规月保费约 ${yuan(model.pricing.typicalPremiumYuan)} 元。`,
  },
];
---

<section class="container-x pb-24 pt-8 md:pb-28 md:pt-10">
  <SectionHead title="为门店分担退货损失" lede="顾客退回的商品往往需要折价处理，这部分少赚的毛利，由智退险赔付。" />
  <div class="mt-12 grid gap-5 md:grid-cols-3">
    {
      items.map((it, i) => (
        <article class="reveal card flex flex-col p-7" style={`--d:${i * 0.08}s`}>
          <span class="grid size-12 place-items-center rounded-full bg-brand-soft text-brand">
            <Icon name={it.icon} class="size-6" />
          </span>
          <h3 class="mt-6 text-[1.3rem]">{it.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-[1.85] text-ink-2">{it.body}</p>
        </article>
      ))
    }
  </div>
</section>
