---
import { Image } from 'astro:assets';
import wardrobe from '../../assets/wardrobe.jpg';
import Wash from '../Wash.astro';
import Icon from '../Icon.astro';
import model from '../../data/model.json';
import { yuan } from '../../lib/format';

const d = model.pricing.deductible;
// 示例月：与理赔页结算示例一致
const exampleTotal = 2178;
const payout = exampleTotal - d;
const fill = Math.min(100, (exampleTotal / 2600) * 100);
const line = (d / 2600) * 100;
---

<div class="relative mx-auto aspect-[1/0.92] w-full max-w-[640px]">
  <Wash tone="mix" seed={0} class="-inset-[10%]" eager />
  <Wash tone="blush" seed={1} class="-right-[16%] top-[34%] h-[66%] w-[66%]" opacity={0.85} eager />

  <Image
    src={wardrobe}
    alt="水彩插画：衣架上挂着大衣、针织衫与连衣裙的服装陈列柜"
    widths={[420, 600]}
    sizes="(min-width: 1024px) 600px, 92vw"
    loading="eager"
    fetchpriority="high"
    class="relative mx-auto mt-[8%] w-[94%] mix-blend-multiply"
  />

  <!-- 浮动卡：月度结算 -->
  <div class="hero-card rise absolute -left-[4%] top-[3%] w-[min(17.5rem,62%)] p-4" style="--d:.25s">
    <p class="flex items-center justify-between text-[0.7rem] font-semibold tracking-[0.12em] text-ink-2">
      <span>本月退货结算 · 示例</span>
      <Icon name="receipt" class="size-4 text-brand" />
    </p>
    <div class="mt-3 flex items-baseline justify-between">
      <span class="text-[0.8rem] text-ink-2">核定损失合计</span>
      <span class="num text-lg">¥{yuan(exampleTotal)}</span>
    </div>
    <div class="relative mt-2 h-2 rounded-full bg-paper-3/70" aria-hidden="true">
      <div class="absolute inset-y-0 left-0 rounded-full bg-lilac" style={`width:${line}%`}></div>
      <div class="absolute inset-y-0 rounded-r-full bg-brand" style={`left:${line}%;width:${fill - line}%`}></div>
      <div class="absolute -top-1 h-4 w-px bg-ink" style={`left:${line}%`}></div>
    </div>
    <div class="mt-2 flex justify-between text-[0.7rem] text-ink-2">
      <span>每月免赔额 ¥{yuan(d)}</span>
      <span>超出部分赔付</span>
    </div>
    <div class="mt-3 flex items-baseline justify-between border-t hairline pt-3">
      <span class="text-[0.8rem] font-semibold">本月赔付</span>
      <span class="num text-2xl text-brand">¥{yuan(payout)}</span>
    </div>
  </div>

  <!-- 浮动卡：单月赔付不封顶 -->
  <div class="hero-card rise absolute -right-[2%] bottom-[6%] flex w-[min(18rem,64%)] items-start gap-3 p-4" style="--d:.45s">
    <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-soft text-brand">
      <Icon name="shield-check" class="size-5" />
    </span>
    <span class="text-[0.8rem] leading-snug">
      <span class="block font-semibold text-ink">单月赔付不封顶</span>
      <span class="mt-1 block text-ink-2">超出免赔额的部分，按实际损失赔付</span>
    </span>
  </div>

  <!-- 衣架问号 → 对勾 -->
  <div class="hook-badge rise absolute right-[9%] top-[6%] grid size-[4.6rem] place-items-center rounded-full bg-paper shadow-[0_18px_40px_-20px_rgb(27_28_32/.5)]" style="--d:.6s" aria-hidden="true">
    <svg viewBox="0 0 64 64" class="size-12 text-brand" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
      <path class="hook-q" pathLength="1" d="M23 19c0-6 4.4-10 9.6-10S42 12.6 42 17.6c0 4.6-3.6 6.4-6.2 8.6-2 1.7-3.8 3.4-3.8 7" />
      <path class="hook-c" pathLength="1" d="M22 19.5l7 7.2L43 11" />
      <path d="M32 33.5 8.6 47.8c-1.6 1-.9 3.4 1 3.4h44.8c1.9 0 2.6-2.4 1-3.4L32 33.5Z" stroke-width="3" />
    </svg>
  </div>
</div>

<style>
  .hero-card {
    border-radius: 18px;
    background: rgb(255 255 255 / 0.82);
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow:
      0 24px 60px -28px rgb(75 35 70 / 0.45),
      0 2px 6px -2px rgb(27 28 32 / 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .hook-q,
  .hook-c {
    stroke-dasharray: 1;
  }
  .hook-q {
    stroke-dashoffset: 0;
  }
  .hook-c {
    stroke-dashoffset: 1;
  }
  .hook-badge .hook-q {
    animation: hook-out 0.7s 1.4s var(--ease-soft) forwards;
  }
  .hook-badge .hook-c {
    animation: hook-in 0.6s 1.95s var(--ease-soft) forwards;
  }
  @keyframes hook-out {
    to {
      stroke-dashoffset: -1;
    }
  }
  @keyframes hook-in {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hook-q {
      stroke-dashoffset: -1;
    }
    .hook-c {
      stroke-dashoffset: 0;
    }
  }
</style>
