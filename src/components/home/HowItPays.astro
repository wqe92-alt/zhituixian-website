---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import Wash from '../Wash.astro';
import model from '../../data/model.json';
import { yuan } from '../../lib/format';
import { url } from '../../lib/url';

const d = model.pricing.deductible;
const exampleTotal = 2178;
const steps = [
  { icon: 'search' as const, title: '门店验收', body: '顾客退货后，确认商品完好、可再次销售，留存收银记录和验收记录。' },
  {
    icon: 'receipt' as const,
    title: '按笔核定',
    body: '每笔退货按“售价 × 赔付比例 × 件数”核定损失。赔付比例一般为 3%–8%，按商品类别和价格确定。',
    example: '例：售价 1,280 元的连衣裙退回 2 件，赔付比例 5%，核定损失 128 元。',
  },
  { icon: 'calendar' as const, title: '按月赔付', body: `每月汇总核定损失，扣除每月免赔额 ${yuan(d)} 元后，余额赔付给您。` },
];
---

<section class="relative overflow-hidden bg-paper-2 py-24 md:py-28">
  <Wash tone="lilac" seed={0} class="-left-[12%] -top-[30%] h-[560px] w-[560px]" opacity={0.55} />
  <div class="container-x relative">
    <SectionHead title="按笔核定，按月赔付" lede="每一笔退货按同一规则核定，每个月结算一次。" />
    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="reveal card relative flex flex-col bg-paper/80 p-7" style={`--d:${i * 0.1}s`}>
            <div class="flex items-center justify-between">
              <span class="grid size-12 place-items-center rounded-full bg-brand-soft text-brand">
                <Icon name={s.icon} class="size-6" />
              </span>
              <span class="num text-sm text-ink-2">第 {i + 1} 步</span>
            </div>
            <h3 class="mt-6 text-xl">{s.title}</h3>
            <p class="mt-3 text-[0.94rem] leading-[1.85] text-ink-2">{s.body}</p>
            {s.example && <p class="mt-3 text-[0.82rem] text-ink-2">{s.example}</p>}
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-8 flex flex-col gap-4 rounded-[22px] bg-ink p-6 text-paper sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <p class="text-[0.9rem] text-paper/70">一个月的赔付示例</p>
      <p class="num flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[clamp(1.2rem,2.4vw,1.7rem)]">
        <span>核定损失 ¥{yuan(exampleTotal)}</span>
        <span class="text-paper/50">−</span>
        <span>免赔额 ¥{yuan(d)}</span>
        <span class="text-paper/50">=</span>
        <span class="text-blush">本月赔付 ¥{yuan(exampleTotal - d)}</span>
      </p>
    </div>
    <a href={url('/claims')} class="link mt-6 inline-block text-[0.92rem]">查看理赔流程</a>
  </div>
</section>
