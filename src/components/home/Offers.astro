---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import Wash from '../Wash.astro';
import { url } from '../../lib/url';
import type { IconName } from '../../lib/icons';

const offers: { icon: IconName; title: string; body: string }[] = [
  { icon: 'percent', title: '数据换利，保费 7 折', body: '每月回传经营数据，保费即按 7 折收取。' },
  { icon: 'chart', title: '经营越好，价格越优', body: '回传的经营记录越多，价格越贴近您门店的实际情况。退货控制得好，保费随之降低。' },
  { icon: 'shield-check', title: '不封顶，不加价', body: '单月赔付不封顶的保障已包含在保费中，无需另外付费。' },
  { icon: 'chat', title: '免费测算，专人服务', body: '在线测算免费、无需注册，顾问一对一解答投保问题。' },
];
---

<section class="relative overflow-hidden bg-ink py-24 text-paper md:py-28">
  <Wash tone="plum" seed={0} class="-right-[12%] -top-[30%] h-[680px] w-[680px]" opacity={0.35} blend="normal" />
  <div class="container-x relative">
    <SectionHead title="投保即可享受的优惠" lede="在保障不打折的前提下，让您的保费更省。" dark />
    <div class="mt-14 grid gap-px overflow-hidden rounded-[22px] bg-paper/12 sm:grid-cols-2 lg:grid-cols-4">
      {
        offers.map((o, i) => (
          <article class="reveal flex flex-col bg-ink p-7 lg:p-8" style={`--d:${i * 0.08}s`}>
            <Icon name={o.icon} class="size-7 text-blush" />
            <h3 class="mt-6 text-[1.25rem] text-paper">{o.title}</h3>
            <p class="mt-3 text-[0.92rem] leading-[1.85] text-paper/70">{o.body}</p>
          </article>
        ))
      }
    </div>
    <a href={url('/pricing')} class="mt-8 inline-flex items-center gap-2 text-[0.92rem] font-semibold text-blush hover:text-paper">
      查看价格与优惠 <Icon name="arrow-right" class="size-4" />
    </a>
  </div>
</section>
