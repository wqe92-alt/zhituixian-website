---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { TEAM } from '../content/team';
import { supportConfig } from '../support/support.config';
import { url } from '../lib/url';
import type { IconName } from '../lib/icons';

const principles: { icon: IconName; title: string; body: string }[] = [
  { icon: 'scale', title: '价格清楚', body: '保费按门店情况测算，报价即时可见，没有额外费用。' },
  { icon: 'receipt', title: '规则统一', body: '每笔退货按同一规则核定，每月结算一次。' },
  { icon: 'users', title: '专人服务', body: '从测算、投保到理赔，顾问全程对接。' },
];
---

<Base title="关于我们" active="/about" description="智退险是面向线下服装门店的退货损失保险服务，按每家门店的实际情况单独定价。">
  <PageHero
    eyebrow="关于我们"
    title="关于智退险"
    lede="智退险是面向线下服装门店的退货损失保险服务。我们按每家门店的实际情况单独定价，帮助商家放心向顾客承诺退换货。"
    tone="mix"
    seed={0}
  >
    <div class="card flex items-center gap-6 bg-paper/85 p-7">
      <Logo variant="mark" class="h-16 w-auto shrink-0 text-brand" />
      <p class="text-[0.94rem] leading-relaxed text-ink-2">
        我们希望退换货承诺成为线下门店的标准服务：顾客买得放心，商家卖得安心。
      </p>
    </div>
  </PageHero>

  <section class="container-x py-20 md:py-28">
    <SectionHead title="服务原则" />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        principles.map((p, i) => (
          <div class="reveal card p-7" style={`--d:${i * 0.08}s`}>
            <Icon name={p.icon} class="size-7 text-brand" />
            <h3 class="mt-6 text-[1.25rem]">{p.title}</h3>
            <p class="mt-3 text-[0.94rem] leading-[1.85] text-ink-2">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="team" class="bg-paper-2 py-20 md:py-28">
    <div class="container-x">
      <SectionHead title="团队" lede="团队成员具有保险与精算专业背景，负责产品设计、定价与客户服务。" />
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          TEAM.map((m, i) => (
            <div class="reveal rounded-[22px] bg-paper p-6" style={`--d:${i * 0.05}s`}>
              <span class="serif grid size-14 place-items-center rounded-full bg-brand-soft text-xl font-semibold text-brand">{m.name.slice(0, 1)}</span>
              <p class="serif mt-5 text-[1.3rem] font-semibold">{m.name}</p>
              <p class="mt-1 text-[0.86rem] text-ink-2">{m.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="bg-ink py-20 text-paper md:py-28">
    <div class="container-x grid gap-10 md:grid-cols-2 md:items-end">
      <div>
        <p class="eyebrow !text-blush">联系我们</p>
        <p class="serif mt-5 text-[clamp(1.8rem,3.6vw,2.6rem)] leading-[1.3]">投保、理赔或合作咨询，欢迎联系我们。</p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <button type="button" data-open-support="合作咨询" class="btn btn-light"><Icon name="chat" class="size-4" /> 在线咨询</button>
        <a href={`tel:${supportConfig.phone.tel}`} class="btn border border-paper/25 text-paper hover:border-paper">
          <Icon name="phone" class="size-4" />
          {supportConfig.phone.display}
        </a>
        <a href={url('/faq')} class="btn border border-paper/25 text-paper hover:border-paper">常见问题</a>
      </div>
    </div>
  </section>
</Base>
