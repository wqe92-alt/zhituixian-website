---
// 全站只在 Base 布局里挂一次：右下角悬浮入口 + 电话联系兜底弹窗
import Icon from '../components/Icon.astro';
import { supportConfig } from './support.config';
---

<button type="button" class="support-launcher no-print" data-open-support aria-label={supportConfig.launcherLabel}>
  <span class="support-launcher__dot" aria-hidden="true"></span>
  <Icon name="chat" class="size-5" />
  <span class="support-launcher__label">{supportConfig.launcherLabel}</span>
</button>

<dialog id="support-fallback" class="support-dialog" aria-labelledby="support-fallback-title">
  <form method="dialog">
    <p class="eyebrow">顾问服务</p>
    <h2 id="support-fallback-title" class="mt-3 text-2xl">联系智退险顾问</h2>
    <p class="mt-3 text-[0.92rem] leading-relaxed text-ink-2">在线对话暂时无法打开。您可以直接致电顾问，或稍后再试。</p>
    <a class="mt-5 flex items-center gap-3 rounded-2xl bg-paper-2 px-5 py-4" href={`tel:${supportConfig.phone.tel}`}>
      <Icon name="phone" class="size-6 text-brand" />
      <span>
        <span class="block text-xs text-ink-2">咨询电话</span>
        <span class="num block text-2xl tracking-wide text-ink">{supportConfig.phone.display}</span>
      </span>
    </a>
    <div data-support-summary-wrap hidden class="mt-4">
      <p class="text-xs text-ink-2">致电时可告知顾问以下信息：</p>
      <pre data-support-summary class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap rounded-xl border hairline bg-white/60 p-3 text-[0.8rem] leading-relaxed text-ink"></pre>
    </div>
    <div class="mt-6 flex justify-end">
      <button class="btn btn-ink !py-2.5" value="close">知道了</button>
    </div>
  </form>
</dialog>

<script>
  import { initSupport } from './index';

  initSupport();
  const launcher = document.querySelector<HTMLElement>('.support-launcher');
  window.addEventListener('support:opened', () => launcher?.setAttribute('hidden', ''));
  window.addEventListener('support:closed', () => launcher?.removeAttribute('hidden'));
</script>

<style>
  .support-launcher {
    position: fixed;
    right: clamp(1rem, 2.5vw, 1.75rem);
    bottom: clamp(1rem, 2.5vw, 1.75rem);
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.15rem 0.8rem 1rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    box-shadow: 0 18px 40px -18px rgb(27 28 32 / 0.6);
    transition:
      transform 0.3s var(--ease-soft),
      background-color 0.3s var(--ease-soft);
  }
  .support-launcher:hover {
    transform: translateY(-2px);
    background: var(--color-brand);
  }
  .support-launcher__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #6fcf97;
    box-shadow: 0 0 0 3px rgb(111 207 151 / 0.25);
  }
  @media (max-width: 640px) {
    .support-launcher {
      padding: 0.85rem;
    }
    .support-launcher__label {
      display: none;
    }
    .support-launcher__dot {
      position: absolute;
      top: 0.45rem;
      right: 0.45rem;
    }
  }
  .support-dialog {
    margin: auto;
    width: min(92vw, 28rem);
    border: 1px solid var(--color-line);
    border-radius: 24px;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 1.8rem;
    box-shadow: 0 30px 80px -30px rgb(27 28 32 / 0.5);
  }
  .support-dialog::backdrop {
    background: rgb(27 28 32 / 0.32);
    backdrop-filter: blur(3px);
  }
</style>
